// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//feature 1

enum RoleUser {
  USER
  ADMIN
  DEVELOPER
}

enum StatusUser {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              BigInt     @id @default(autoincrement())
  fullName        String?
  role            RoleUser   @default(USER)
  email           String     @unique
  password        String?
  isEmailVerified Boolean    @default(false)
  phone           String?
  profilePic      String?
  status          StatusUser @default(ACTIVE)
  googleId        String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  userTokens            UserToken[]
  saveJobs              SaveJob[]
  userProfile           UserProfile?
  jobApplications       JobApplication[]
  payments              Payment[]
  subscriptions         Subscription[]
  cvDocuments           CvDocument[]
  companyReviews        CompanyReview[]
  employeeVerifications EmployeeVerification[]
  assessments           Assessment[]
  userAssessments       UserAssessment[]
  userBadges            UserBadge[]
  company               Company?

  @@map("users")
}

model UserProfile {
  userId         BigInt    @id
  birthPlace     String?
  birthDate      DateTime? @db.Date
  gender         Gender?
  educationLevel String?
  address        String?
  city           String?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

model Company {
  id          BigInt    @id @default(autoincrement())
  adminId     BigInt    @unique
  name        String
  slug        String    @unique
  phone       String
  email       String
  logo        String?
  description String?
  industry    String?
  city        String?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  website     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  admin                 User                   @relation(fields: [adminId], references: [id])
  jobPostings           JobPosting[]
  companyReviews        CompanyReview[]
  employeeVerifications EmployeeVerification[]

  @@map("companies")
}

model SaveJob {
  userId  BigInt
  jobId   BigInt
  savedAt DateTime   @default(now())
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("save_jobs")
}

//feature 2

enum ApplicationStatus {
  PENDING
  PROCESSED
  INTERVIEW
  ACCEPTED
  REJECTED
}

model JobPosting {
  id                  BigInt   @id @default(autoincrement())
  companyId           BigInt
  title               String
  description         String   @db.Text
  bannerUrl           String?
  category            String
  city                String
  province            String?
  latitude            Float?
  longitude           Float?
  salaryMin           Int?
  salaryMax           Int?
  tags                String[] // Array of strings di PostgreSQL
  deadline            DateTime
  isPublished         Boolean  @default(false)
  hasPreSelectionTest Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id])
  preSelectionTest PreSelectionTest?
  applications     JobApplication[]
  saveJobs         SaveJob[]

  @@map("job_postings")
}

model PreSelectionTest {
  id           BigInt   @id @default(autoincrement())
  jobPostingId BigInt   @unique
  passingScore Int      @default(70)
  createdAt    DateTime @default(now())

  jobPosting JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  questions  PreTestQuestion[]

  @@map("preselection_tests")
}

model PreTestQuestion {
  id             BigInt @id @default(autoincrement())
  testId         BigInt
  questionNumber Int // 1 sampai 25
  questionText   String @db.Text
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctOption  String // "A", "B", "C", atau "D"

  test    PreSelectionTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers PreTestAnswer[]

  @@map("pretest_questions")
}

// Tabel ini menjembatani Feature 1 (Apply Job) dan Feature 2 (Applicant Management & Pre-Test)
model JobApplication {
  id              BigInt            @id @default(autoincrement())
  userId          BigInt
  jobPostingId    BigInt
  cvUrl           String
  expectedSalary  Int
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?           @db.Text
  testScore       Int? // Skor dari Pre-Selection Test (0-100)
  isPriority      Boolean           @default(false) // Diambil dari status Subscription F3
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting     JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  testAnswers    PreTestAnswer[]
  interviews     InterviewSchedule[]
  companyReviews CompanyReview[]

  @@map("job_applications")
}

model PreTestAnswer {
  id                BigInt           @id @default(autoincrement())
  applicationId     BigInt
  questionId        BigInt
  selectedOption    String // "A", "B", "C", atau "D"
  preTestQuestion   PreTestQuestion? @relation(fields: [preTestQuestionId], references: [id])
  preTestQuestionId BigInt?
  jobApplication    JobApplication?  @relation(fields: [jobApplicationId], references: [id])
  jobApplicationId  BigInt?

  @@map("pretest_answers")
}

model InterviewSchedule {
  id               BigInt          @id @default(autoincrement())
  applicationId    BigInt
  scheduledAt      DateTime
  locationOrLink   String
  notes            String?         @db.Text
  reminderSent     Boolean         @default(false) // Flag untuk Cron Job H-1
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  jobApplication   JobApplication? @relation(fields: [jobApplicationId], references: [id])
  jobApplicationId BigInt?

  @@map("interview_schedules")
}

//feature 3
model Payment {
  id               BigInt        @id @default(autoincrement())
  subscriptionId   BigInt
  approvedBy       BigInt?
  amount           Int
  method           MethodPayment
  status           PaymentStatus @default(PENDING)
  paymentProofUrl  String?
  gatewayReference String?       @unique
  createdAt        DateTime      @default(now())
  expiredAt        DateTime
  approvedAt       DateTime?
  proofUploadedAt  DateTime?

  approver     User?        @relation("PaymentApprover", fields: [approvedBy], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

enum MethodPayment {
  BANK_TRANSFER
  PAYMENT_GATEWAY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Subscription {
  id        BigInt             @id @default(autoincrement())
  userId    BigInt
  planId    BigInt
  startDate DateTime?
  endDate   DateTime?
  status    SubscriptionStatus @default(PENDING)
  payments  Payment[]

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

model SubscriptionPlan {
  id                        BigInt         @id @default(autoincrement())
  name                      String         @unique
  price                     Int
  durationInDays            Int            @default(30)
  cvGenerator               Boolean        @default(false)
  priorityReview            Boolean        @default(false)
  skillAssessmentLimitation Int            @default(0)
  subscriptions             Subscription[]

  @@map("subscription_plans")
}

model CvDocument {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  title     String
  content   Json
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("cv_documents")
}

model CompanyReview {
  id                  BigInt   @id @default(autoincrement())
  companyId           BigInt
  userId              BigInt
  jobaApplicationId   BigInt?
  jobTitle            String
  salaryEstimation    Int
  ratingCulture       Int
  ratingWorkLife      Int
  ratingFacilities    Int
  ratingCareer        Int
  reviewForCompany    String?
  adviceForManagement String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  // relation ke company table bisa ditambahkan jika ada model Company
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId])
  @@map("company_reviews")
}

model EmployeeVerification {
  id          BigInt             @id @default(autoincrement())
  companyId   BigInt
  userId      BigInt
  jobPosition String
  status      VerificationStatus
  verifiedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id])
  // relation ke company table bisa ditambahkan jika ada model Company
  company Company @relation(fields: [companyId], references: [id])

  @@map("employee_verifications")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Assessment {
  id           BigInt           @id @default(autoincrement())
  title        String
  description  String?
  skillName    String
  badgeName    String
  badgeIconUrl String
  status       AssessmentStatus @default(DRAFT)
  createdById  BigInt
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy           User                 @relation(fields: [createdById], references: [id])
  assessmentAttempts  AssessmentAttempt[]
  assessmentQuestions AssessmentQuestion[]
  certificates        Certificate[]

  @@map("assessments")
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AssessmentAttempt {
  id           BigInt                  @id @default(autoincrement())
  userId       BigInt
  assessmentId BigInt
  status       AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime                @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  score        Int?
  isPassed     Boolean?

  user              User               @relation(fields: [userId], references: [id])
  assessment        Assessment         @relation(fields: [assessmentId], references: [id])
  assessmentAnswers AssessmentAnswer[]
  certificate       Certificate?

  @@map("assessment_attempts")
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model AssessmentQuestion {
  id           BigInt    @id @default(autoincrement())
  assessmentId BigInt
  questionText String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assessment        Assessment         @relation(fields: [assessmentId], references: [id])
  assessmentOptions AssessmentOption[]
  assessmentAnswers AssessmentAnswer[]

  @@map("assessment_questions")
}

model AssessmentOption {
  id         BigInt    @id @default(autoincrement())
  questionId BigInt
  optionText String
  isCorrect  Boolean
  deletedAt  DateTime?

  question          AssessmentQuestion @relation(fields: [questionId], references: [id])
  assessmentAnswers AssessmentAnswer[]

  @@map("assessment_options")
}

model AssessmentAnswer {
  id               BigInt @id @default(autoincrement())
  attemptId        BigInt
  questionId       BigInt
  selectedOptionId BigInt

  attempt        AssessmentAttempt  @relation(fields: [attemptId], references: [id])
  question       AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedOption AssessmentOption   @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("assessment_answers")
}

model Certificate {
  id              BigInt   @id @default(autoincrement())
  certificateCode String   @unique
  attemptId       BigInt   @unique
  userId          BigInt
  assessmentId    BigInt
  recipientName   String
  certificateUrl  String
  issuedAt        DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id])
  assessment Assessment        @relation(fields: [assessmentId], references: [id])
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id])

  @@unique([userId, assessmentId])
  @@map("certificates")
}
